###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8&charset=utf8mb4"
DATABASE_URL="pdo_mysql://root:12345678@localhost:3306/sf_skeleton"
###< doctrine/doctrine-bundle ###

### whatafunc/db-diff-auditor bundle ###
# Database connection settings
DB_DRIVER=mysql
DB_HOST=localhost
DB_NAME=sf_skeleton
DB_USER=root
DB_PASSWORD=12345678
DB_PORT=3306
# Optional: path to the snapshots directory
DB_SNAPSHOT_PATH=.db-snapshots

# Optional: comma-separated list of tables to ignore
DB_IGNORE_TABLES=migrations,sessions
###< whatafunc/db-diff-auditor bundle ###